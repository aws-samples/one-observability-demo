# TDIR preset - Threat Detection and Incident Response.
# Deploys a pre-compromised AI agent environment for security investigation labs:
# GuardDuty, Security Hub, Detective, a poisonable knowledge base, automated remediation.
#
# SIZE LIMIT: keep this under ~3 KB. The deployment buildspec stores the merged .env in an
# SSM Standard-tier parameter, capped at 4096 characters, and appends ~650 characters of its
# own. Going over makes put-parameter fail and the pipeline synth gets an empty config.

# --- Infrastructure ---
CREATE_VPC=true
VPC_CIDR=10.0.0.0/16
# Required by both Detective and GuardDuty.
CREATE_CLOUDTRAIL=true

# --- Workshop options ---
CUSTOM_ENABLE_EXPORT_PAGE=false
CUSTOM_ENABLE_WAF=true
CUSTOM_ENABLE_CLOUDFRONT_LOGS=true
CUSTOM_ENABLE_NETWORKING_TRAIL=true
CUSTOM_ENABLE_SLO=false
EKS_CLUSTER_ACCESS_ROLE_NAME=WSParticipantRole

# Leave false. CUSTOM_ENABLE_GUARDDUTY_DETECTOR turns on GuardDuty's own
# EKS_ADDON_MANAGEMENT, which owns aws-guardduty-agent and races the CDK addon in
# lib/constructs/eks.ts. Runtime findings still reach Detective either way.
CUSTOM_ENABLE_GUARDDUTY_EKS_ADDON=false

# --- Threat Detection and Incident Response ---
CUSTOM_ENABLE_GUARDDUTY_DETECTOR=true
CUSTOM_ENABLE_SECURITY_HUB=true
CUSTOM_ENABLE_DETECTIVE=true
CUSTOM_ENABLE_KNOWLEDGE_BASE=true
CUSTOM_ENABLE_TDIR_REMEDIATION=true

# The simulated AgentEscalatedAccess role the evidence names. It is assumable and the
# escalation really assumes it - that is what makes the CloudTrail and Detective evidence
# real. Safety comes from the TdirWorkshopBoundary permissions boundary.
CUSTOM_ENABLE_TDIR_ESCALATED_ROLE=true

# Leave false. The Unified Data Store's telemetry rules produce nothing any lab reads, and
# enabling them makes `aws observabilityadmin start-telemetry-evaluation` a hard
# pre-deployment step - skip it and every rule fails and the stack rolls back.
CUSTOM_ENABLE_UDS=false
CUSTOM_ENABLE_UDS_WAF_LOGS=false
CUSTOM_ENABLE_UDS_CLOUDTRAIL_LOGS=false
CUSTOM_ENABLE_UDS_GUARDDUTY_FINDINGS=false
CUSTOM_ENABLE_UDS_BEDROCK_AGENTCORE_LOGS=false
CUSTOM_ENABLE_UDS_EKS_LOGS=false
CUSTOM_ENABLE_UDS_CLOUDFRONT_LOGS=false

# --- Application ---
# Required - the agents under investigation. Only this spelling works:
# validate-account.sh matches it to compute AVAILABILITY_ZONES, without which AgentCore
# can land in unsupported AZs (lib/constructs/network.ts).
ENABLE_WAGGLE_AI_AGENTS=true
ENABLE_OPENSEARCH=false

# --- Account-specific ---
AUTO_TRANSACTION_SEARCH_CONFIGURED=false
CONCURRENT_USERS=5

# Leave false while seeding: sample GuardDuty findings are severity 8 and would trigger
# containment immediately. Scoped to the AgentEscalatedAccess role only.
CUSTOM_ENABLE_TDIR_REMEDIATION_ENFORCE=false
