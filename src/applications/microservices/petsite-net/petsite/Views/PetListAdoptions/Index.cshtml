@model List<AdoptedPet>

@{
    ViewData["Title"] = "Pet Adoption List";
}

<section class="pet-hero">
    <div class="container">
        <partial name="_Hero" />
    </div>
</section>

<br>

<h2 class="text-center mb-4" style="color: #006400; font-weight: bold;">Adopted Pet List</h2>

<div class="container">
    @if (Model.Any())
    {
        <div class="pet-grid">
            @foreach (var pet in Model)
            {
                <div class="pet-item">
                    <partial name="_AdoptionItem" for="@pet" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center my-4" role="alert">
            <i class="bi bi-info-circle fs-3 me-3" aria-hidden="true"></i>
            <div>
                <h4 class="alert-heading h5 mb-1">No adoption data available!</h4>
                <p class="mb-0">No adoption data retrieved at this time. Please check back later.</p>
            </div>
        </div>
    }
</div>
