@{
    ViewData["Title"] = "House Keeping";
}

<section class="pet-hero">
    <div class="container">
        <partial name="_Hero" />
    </div>
</section>

<div class="container my-4">
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Error</h4>
            <hr>
            <p class="mb-0">@Html.Raw(ViewBag.ErrorMessage.Replace("\n", "<br>"))</p>
        </div>
    }
    else
    {
        <div class="alert alert-success" role="alert">
            <h4 class="alert-heading"><i class="bi bi-check-circle" aria-hidden="true"></i> Housekeeping Complete</h4>
            <hr>
            <p class="mb-0">All pets open for adoption!</p>
        </div>
    }
</div>