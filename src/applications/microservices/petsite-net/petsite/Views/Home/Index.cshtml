@using PetSite.ViewModels;

@{
    ViewData["Title"] = "Home";
    @model PetDetails;

    var petCount = Model.Pets?.Count() ?? 0;

    // Fixed hero pair; the CDN host comes from a result peturl so it works in every deployment.
    string heroPuppy = null, heroKitten = null;
    var sample = Model.Pets?.FirstOrDefault(p => !string.IsNullOrEmpty(p.peturl))?.peturl;
    if (!string.IsNullOrEmpty(sample) && Uri.TryCreate(sample, UriKind.Absolute, out var sampleUri))
    {
        var cdn = sampleUri.GetLeftPart(UriPartial.Authority);
        heroPuppy = cdn + "/puppies/p9.jpg";
        heroKitten = cdn + "/kittens/k1.jpg";
    }
}

<div class="ps-shell">
    <section class="ps-hero">
        <div>
            <h1>Adopt a pet,<br /><span class="ps-hl">make a friend!</span></h1>
            <p class="ps-lede">
                @if (petCount > 0)
                {
                    <text>@petCount pets are looking for a home right now. Search below, or ask Waggle
                    to match one to your home.</text>
                }
                else
                {
                    <text>Browse puppies, kittens and bunnies ready for adoption, or ask Waggle to
                    match one to your home.</text>
                }
            </p>

            <div class="ps-controls">
                <form method="get">
                    <label class="pet-label" data-title="Type">
                        <select name="selectedPetType" asp-for="@Model.Varieties.SelectedPetType"
                                asp-items="@Model.Varieties.PetTypes" class="pet-filter"
                                aria-label="Pet type"></select>
                    </label>
                    <label class="pet-label" data-title="Color">
                        <select name="selectedPetColor" asp-for="@Model.Varieties.SelectedPetColor"
                                asp-items="@Model.Varieties.PetColors" class="pet-filter"
                                aria-label="Colour"></select>
                    </label>
                    <input type="hidden" name="userId" value="@ViewBag.UserId" />
                    <input id="searchpets" type="submit" value="Search" />
                </form>
            </div>
        </div>

        @if (heroPuppy != null)
        {
            <div class="ps-collage" aria-hidden="true">
                <span class="ps-wash"></span>
                <div class="ps-shot ps-shot-a"><img src="@heroPuppy" alt="" loading="lazy" /></div>
                <div class="ps-shot ps-shot-b"><img src="@heroKitten" alt="" loading="lazy" /></div>
                <span class="ps-shotchip">
                    <svg viewBox="0 0 24 24">
                        <ellipse cx="12" cy="15.6" rx="4.2" ry="3.5" />
                        <ellipse cx="6.2" cy="10.2" rx="2" ry="2.6" />
                        <ellipse cx="17.8" cy="10.2" rx="2" ry="2.6" />
                        <ellipse cx="9.4" cy="6.2" rx="1.8" ry="2.3" />
                        <ellipse cx="14.6" cy="6.2" rx="1.8" ry="2.3" />
                    </svg>
                    Ready for adoption
                </span>
            </div>
        }
    </section>

    <section class="ps-banner">
        <div class="ps-banner-row">
            <div>
                <h2>Not sure which pet suits you?</h2>
                <p>Tell Waggle about your home and routine. It will suggest a match and pick out
                   their first food.</p>
            </div>
            <a class="ps-cta" asp-controller="Waggle" asp-action="Index" asp-route-userId="@ViewBag.UserId">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.8l1.45 4.15 4.15 1.55-4.15 1.45L12 14.1l-1.45-4.15L6.4 8.5l4.15-1.55L12 2.8z" />
                    <path d="M18.7 13.6l.8 2.3 2.3.8-2.3.8-.8 2.3-.8-2.3-2.3-.8 2.3-.8.8-2.3z" />
                </svg>
                Ask Waggle
            </a>
        </div>
    </section>

    @if (Model.Pets.Any())
    {
        <div class="pet-items ps-grid">
            @foreach (var pet in Model.Pets)
            {
                <div class="pet-item">
                    <partial name="_PetItem" for="@pet" />
                </div>
            }
        </div>
    }
    else if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error</h4>
            <hr />
            <p class="mb-0">@Html.Raw(ViewBag.ErrorMessage.Replace("\n", "<br>"))</p>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">No result</h4>
            <hr />
            <p class="mb-0">No pets found for that search criteria.</p>
        </div>
    }
</div>
