@using Microsoft.AspNetCore.Html
@using Amazon.SimpleSystemsManagement
@using Amazon.SimpleSystemsManagement.Model
@{
    string rumScript = "";
    try
    {
        rumScript = new AmazonSimpleSystemsManagementClient().GetParameterAsync(new GetParameterRequest() { Name = "/petstore/rumscriptparameter" }).Result.Parameter.Value;
    }
    catch
    {
        // RUM script not available
    }

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string ActiveIf(bool cond) => cond ? " active-page" : "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    @if (!string.IsNullOrWhiteSpace(rumScript))
    {
        @Html.Raw(rumScript)
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Observability Pet Adoptions</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/petstyles.css" asp-append-version="true" />
</head>

<body style="padding-bottom: 60px;">
    <div class="pet-wrapper">
        <header class="pet-header">
            <div class="container">
                <nav class="pet-nav">
                    <a asp-controller="home" asp-action="index" asp-route-userId="@ViewBag.UserId"
                       class="pet-brand" aria-label="Observability Pet Adoptions home">
                        <span class="pet-brand-icon" aria-hidden="true">🐶</span>
                        <span class="pet-brand-text">Observability<span class="pet-brand-accent"> Pet Adoptions</span></span>
                    </a>
                    <div class="pet-nav-links">
                        <a asp-controller="Waggle" asp-action="Index" asp-route-userId="@ViewBag.UserId"
                           class="pet-nav-link@(ActiveIf(controller == "Waggle"))">
                            <i class="bi bi-chat-dots" aria-hidden="true"></i> Waggle AI
                        </a>
                        <a asp-controller="FoodService" asp-action="Index" asp-route-userId="@ViewBag.UserId"
                           asp-route-petType="puppy"
                           class="pet-nav-link@(ActiveIf(controller == "FoodService"))">
                            <i class="bi bi-bag-heart" aria-hidden="true"></i> Buy Food
                        </a>
                        <a asp-controller="PetListAdoptions" asp-action="index" asp-route-userId="@ViewBag.UserId"
                           id="seeadoptionlist"
                           class="pet-nav-link@(ActiveIf(controller == "PetListAdoptions"))">
                            <i class="bi bi-list-check" aria-hidden="true"></i> See Adoption List
                        </a>
                        <a asp-controller="Home" asp-action="HouseKeeping" asp-route-userId="@ViewBag.UserId"
                           id="performhousekeeping"
                           class="pet-nav-link@(ActiveIf(controller == "Home" && action == "HouseKeeping"))">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Perform Housekeeping
                        </a>
                        <a asp-controller="Checkout" asp-action="Index" asp-route-userId="@ViewBag.UserId"
                           class="pet-nav-link pet-nav-cart@(ActiveIf(controller == "Checkout"))" aria-label="Cart">
                            <i class="bi bi-cart-fill" aria-hidden="true"></i>
                            <span id="cart-count" class="pet-cart-count" style="display: none;"></span>
                        </a>
                    </div>
                </nav>
            </div>
        </header>
        @RenderBody()

        <footer
            style="position: fixed; bottom: 0; left: 0; width: 100%; background-color: #f8f9fa; border-top: 1px solid #dee2e6; text-align: center; padding: 10px 0; z-index: 1000;">
            <div class="container">
                <p class="mb-0" style="color: #6c757d; font-size: 0.9rem;">
                    Built with ❤️ in association with <a href="https://kiro.dev/" target="_blank"
                        style="background: linear-gradient(135deg, #4A90E2 0%, #7B68EE 50%, #9B59B6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-decoration: none; font-weight: 600;">Kiro</a>
                </p>
            </div>
        </footer>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Update cart count on every page load
            var userId = '@ViewBag.UserId';
            if (userId) {
                $.ajax({
                    url: '/FoodService/GetCartCount',
                    type: 'GET',
                    data: { userId: userId },
                    success: function (response) {
                        if (response.totalItems > 0) {
                            $('#cart-count').text(response.totalItems).show();
                        } else {
                            $('#cart-count').hide();
                        }
                    },
                    error: function (xhr) {
                        $('#cart-count').hide();
                    }
                });
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>

</html>
