@model Pet;

@{
    var showTakeMeHomeButton = ViewData["ShowTakeMeHomeButton"] as bool? ?? true;
    var cuteness = (!string.IsNullOrEmpty(Model.cuteness_rate) && Int32.TryParse(Model.cuteness_rate, out var r)) ? r : 0;
}

@if (showTakeMeHomeButton)
{
    <form asp-controller="adoption" asp-action="takemehome" method="post" class="pet-card h-100">
        <img class="pet-thumbnail" src="@Model.peturl" alt="@Model.pettype @Model.petcolor for adoption" />

        <div class="pet-name">
            <span>@Model.pettype-@Model.petcolor</span>
        </div>
        <div class="pet-price">
            <span>@Model.price</span>
        </div>

        <div class="pet-rating" role="img" aria-label="Cuteness rating @cuteness out of 5">
            @for (int i = 0; i < 5; i++)
            {
                <i class="bi @(i < cuteness ? "bi-star-fill" : "bi-star") pet-star" aria-hidden="true"></i>
            }
        </div>

        @if (Model.availability.ToLower() == "yes")
        {
            <input class="pet-button" type="submit" value="Take me home" />
        }
        else
        {
            <span class="badge bg-danger pet-unavailable">Unavailable</span>
        }

        <input type="hidden" asp-for="@Model.petcolor" name="petcolor" />
        <input type="hidden" asp-for="@Model.petid" name="petid" />
        <input type="hidden" asp-for="@Model.pettype" name="pettype" />
        <input type="hidden" asp-for="@Model.peturl" name="peturl" />
        <input type="hidden" asp-for="@Model.price" name="price" />
        <input type="hidden" asp-for="@Model.cuteness_rate" name="cuteness_rate" />
        <input type="hidden" name="userId" value="@ViewBag.UserId" />
    </form>
}
else
{
    <div class="pet-card h-100">
        <img class="pet-thumbnail" src="@Model.peturl" alt="@Model.pettype @Model.petcolor for adoption" />

        <div class="pet-name">
            <span>@Model.pettype-@Model.petcolor</span>
        </div>
        <div class="pet-price">
            <span>@Model.price</span>
        </div>

        <div class="pet-rating" role="img" aria-label="Cuteness rating @cuteness out of 5">
            @for (int i = 0; i < 5; i++)
            {
                <i class="bi @(i < cuteness ? "bi-star-fill" : "bi-star") pet-star" aria-hidden="true"></i>
            }
        </div>

        <input type="hidden" asp-for="@Model.petcolor" name="petcolor" />
        <input type="hidden" asp-for="@Model.petid" name="petid" />
        <input type="hidden" asp-for="@Model.pettype" name="pettype" />
        <input type="hidden" asp-for="@Model.peturl" name="peturl" />
        <input type="hidden" asp-for="@Model.price" name="price" />
        <input type="hidden" asp-for="@Model.cuteness_rate" name="cuteness_rate" />
    </div>
}
