@using PetSite.ViewModels
@{
    ViewData["Title"] = "Adopt Me";
    @model Pet;
}

@* Bootstrap 5 + Bootstrap Icons + jQuery are loaded globally by _Layout. The
   previous version of this page pulled a SECOND Bootstrap (5.1.3) and jQuery
   from a CDN on top of the layout's framework — removed to avoid duplication
   and to keep all assets served locally. *@

<section class="pet-hero">
    <div class="container">
        <partial name="_Hero" />
    </div>
</section>

<div class="container mt-2" >
    <div class="row" >
        <div class="col-md-6">
            <div class="pet-items mb-4">
                <partial name="_PetItem" for="@Model" view-data='@new ViewDataDictionary(ViewData) { { "ShowTakeMeHomeButton", false } }' />
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="h5 mb-0">Payment Details</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning py-2" role="alert">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        This is a demo - no real payment will be processed.
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="cardName">Name on Card</label>
                        <input type="text" class="form-control" id="cardName" value="John Doe" readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="cardNumber">Card Number</label>
                        <input type="text" class="form-control" id="cardNumber" value="4111 1111 1111 1111" readonly>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label" for="expiry">Expiry Date</label>
                            <input type="text" class="form-control" id="expiry" value="12/30" readonly>
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="cvv">CVV</label>
                            <input type="text" class="form-control" id="cvv" value="123" readonly>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="fw-semibold">Final Payment</span>
                        <span class="badge bg-success fs-6">@Model.price</span>
                    </div>

                    <form asp-controller="Payment" asp-action="MakePayment" method="post" class="mt-3">
                        <input class="btn btn-success btn-lg w-100" type="submit" value="Pay and Adopt" />
                        <input type="hidden" asp-for="@Model.petid" name="petid" />
                        <input type="hidden" asp-for="@Model.pettype" name="pettype" />
                        <input type="hidden" asp-for="@Model.peturl" name="peturl" />
                        <input type="hidden" name="userId" value="@ViewBag.UserId" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



