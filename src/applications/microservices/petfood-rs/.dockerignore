# Build artifacts
target/
# NOTE: Cargo.lock is intentionally NOT ignored. It must be copied into the
# build context so `cargo build` uses the pinned dependency versions
# (reproducible builds) instead of re-resolving Cargo.toml semver ranges at
# build time, which can pull in breaking upstream releases. See RCA 2026-09-14.

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Test files (we only copy src for production)
tests/
benches/

# Docker files
Dockerfile
.dockerignore

# Logs
*.log

# Environment files
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/